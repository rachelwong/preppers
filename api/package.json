    "dev": "tsx watch src/index.ts",
    "openapi": "tsx src/openapi.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.3",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
